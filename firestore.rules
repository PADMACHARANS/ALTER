rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Standard helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation helper for User profile
    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             (!('preferredLanguage' in data) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 50)) &&
             (!('learningLevel' in data) || (data.learningLevel in ['Beginner', 'Intermediate', 'Advanced'])) &&
             data.guidelinesAccepted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('progress' in data) || data.progress is map);
    }

    // User collection path match
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false; // Users cannot list other users or broad scan

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().keys().hasAll(['uid', 'email', 'displayName', 'fullName', 'guidelinesAccepted', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'displayName', 'fullName', 'preferredLanguage', 'learningLevel', 'guidelinesAccepted', 'createdAt', 'updatedAt', 'progress']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().keys().hasAll(['uid', 'email', 'displayName', 'fullName', 'guidelinesAccepted', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'fullName', 'preferredLanguage', 'learningLevel', 'guidelinesAccepted', 'updatedAt', 'progress']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }
  }
}
